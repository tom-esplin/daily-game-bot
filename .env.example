DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
# Register commands in this server for immediate availability.
DISCORD_GUILD_ID=your_server_id
DATABASE_PATH=./data/scores.sqlite
# Required only for the optional AI daily player. Never paste the key into Discord.
OPENAI_API_KEY=your_openai_api_key
# Optional: override the music listener with an audio-input Chat Completions model your key can access.
# OPENAI_AUDIO_MODEL=gpt-audio-1.5
# Music defaults to the free local trained listener. Use openai only with audio model access.
DAILY_AUDIO_BACKEND=local
